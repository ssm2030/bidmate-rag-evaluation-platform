{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "relative_pdf_path", "sha256", "page_count", "legacy_filename", "external_ids", "source_classification", "external_transmission_allowed"],
  "properties": {"document_id":{"type":"string","format":"uuid"},"relative_pdf_path":{"type":"string","pattern":"^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?/).+"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"page_count":{"type":"integer","minimum":1},"legacy_filename":{"type":"string","minLength":1},"external_ids":{"type":"object","additionalProperties":{"type":"string"}},"source_classification":{"enum":["public","private","unknown"]},"external_transmission_allowed":{"type":"boolean"}}
}
